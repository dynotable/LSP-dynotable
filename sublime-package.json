{
	"contributions": {
		"settings": [
			{
				"file_patterns": [
					"/LSP-dynotable.sublime-settings"
				],
				"schema": {
					"$id": "sublime://settings/LSP-dynotable",
					"definitions": {
						"PluginConfig": {
							"type": "object",
							"properties": {
								"launch_app": {
									"type": "boolean",
									"default": false,
									"markdownDescription": "When DynoTable is not running, the first start of the language server starts it with no window."
								}
							}
						}
					},
					"allOf": [
						{
							"$ref": "sublime://settings/LSP-plugin-base"
						},
						{
							"$ref": "sublime://settings/LSP-dynotable#/definitions/PluginConfig"
						}
					]
				}
			},
			{
				"file_patterns": [
					"/LSP.sublime-settings"
				],
				"schema": {
					"properties": {
						"clients": {
							"properties": {
								"LSP-dynotable": {
									"$ref": "sublime://settings/LSP-dynotable#/definitions/PluginConfig"
								}
							}
						}
					}
				}
			},
			{
				"file_patterns": [
					"/*.sublime-project"
				],
				"schema": {
					"properties": {
						"settings": {
							"properties": {
								"LSP": {
									"properties": {
										"LSP-dynotable": {
											"$ref": "sublime://settings/LSP-dynotable#/definitions/PluginConfig"
										}
									}
								}
							}
						}
					}
				}
			}
		]
	}
}
